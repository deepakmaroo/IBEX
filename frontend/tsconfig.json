{
  "compilerOptions": {
    "target": "ES6",
    "allowJs": true,
    "module": "Commonjs",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "baseUrl": ".",
    "outDir": "dist",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    // "typeRoots": ["./node_modules/@types"],
    "types": ["node", "mocha"],
    "paths": {
      "*": ["node_modules/*"],
      "src/*": ["src/*"]
    },
    "jsx": "react-jsx"
  },
  "include": ["src/**/*", "__tests__/**/*"]
}
