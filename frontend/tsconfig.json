{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "allowJs": true,
    "moduleResolution": "node",
    "noImplicitAny": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "outDir": "dist",
    "rootDir": "src",
    "resolveJsonModule": true,
    "baseUrl": ".",

    "types": ["node", "mocha"],
    "paths": {
      "*": ["node_modules/*"],
      "src/*": ["src/*"]
    },
    "jsx": "react-jsx"
  },
  "include": ["src/**/*", "__tests__/**/*"]
}
