#!/bin/env python3
# -*- coding: utf-8 -*-
from ibex.main import app
import uvicorn  # type: ignore
import argparse  # type: ignore
import sys


if __name__ == "__main__":

    parser = argparse.ArgumentParser()
    parser.add_argument(
        "-p",
        "--port",
        type=int,
        help="""Specify port number to start server on {0..65535}""",
    )
    args = parser.parse_args(args=sys.argv[1:])

    if args.port and (args.port < 0 or args.port > 65535):
        print(
            f"Provided port number was {args.port} while it has to be in range (0..65535).",
            file=sys.stderr,
        )
        exit(-1)

    uvicorn.run(app, host="127.0.0.1", port=args.port if args.port else 0)
